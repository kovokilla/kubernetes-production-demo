{
  "uid": "production-demo-overview",
  "title": "Application & Jenkins Overview",
  "description": "Local kind application, Jenkins availability and deployment-credential overview. SSH availability is not Jenkins connection state; no build-result or Warp billing metrics are collected.",
  "tags": ["kubernetes", "jenkins", "demo"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Application API",
      "description": "HTTP probe through Traefik, frontend and backend.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(probe_success{monitor_target=\"application-api\"})", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jenkins controller HTTP",
      "description": "Checks the login endpoint only, not build success.",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(probe_success{monitor_target=\"jenkins-controller\"})", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Jenkins agent SSH",
      "description": "An available SSH banner does not prove the agent is connected to Jenkins.",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max(probe_success{monitor_target=\"jenkins-agent-ssh\"})", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Deployment credential remaining",
      "description": "Public expiry metadata only. Renew using scripts/jenkins-refresh-credentials.sh. Negative values mean expired.",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "(max(jenkins_deployer_credential_expiry_timestamp_seconds > 0) - time()) / 3600", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: h", "decimals": 1, "noValue": "Metadata missing",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 4 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Application replicas — available versus desired",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "kube_deployment_status_replicas_available{namespace=\"demo\",deployment=~\"demo-(frontend|backend)\"}", "legendFormat": "{{deployment}} available" },
        { "refId": "B", "expr": "kube_deployment_spec_replicas{namespace=\"demo\",deployment=~\"demo-(frontend|backend)\"}", "legendFormat": "{{deployment}} desired" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Application restarts over the previous 15 minutes",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=\"demo\",container=~\"frontend|backend\"}[15m]))", "legendFormat": "{{container}}" }],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Probe duration",
      "description": "Blackbox probe duration, not end-user request latency or application percentiles.",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "probe_duration_seconds{monitor_target=~\"application-api|jenkins-controller|jenkins-agent-ssh\"}", "legendFormat": "{{monitor_target}}" }],
      "fieldConfig": { "defaults": { "min": 0, "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Firing application / Jenkins / monitoring alerts",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\",alertname=~\"Demo.*|Jenkins.*|Monitoring.*\"}) or vector(0)", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    }
  ]
}
