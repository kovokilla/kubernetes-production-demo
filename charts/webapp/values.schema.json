{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["frontend", "backend", "existingSecret"],
  "properties": {
    "fullnameOverride": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 50 },
    "message": { "type": "string" },
    "existingSecret": { "type": "string", "minLength": 1 },
    "secretRevision": { "type": "string" },
    "frontend": { "$ref": "#/definitions/component" },
    "backend": { "$ref": "#/definitions/component" },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "minLength": 1 },
        "className": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["image", "resources", "replicas"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 2 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        }
      }
    }
  }
}
